      "html": "<label class=\"ds-field\" for=\"ds-q\">Search highlights</label><input class=\"ds-input\" id=\"ds-q\" placeholder=\"Search highlights\">",
      "css": ".ds-field{display:block;margin-bottom:4px;color:var(--text-muted,#64748b);font:600 0.75rem/1.33 Inter,system-ui,sans-serif;letter-spacing:0.05em;text-transform:uppercase}.ds-input{width:100%;box-sizing:border-box;padding:8px 12px;background-color:var(--bg-card,#ffffff);color:var(--text-primary,#1e293b);font:400 0.875rem/1.5 Inter,system-ui,sans-serif;border:1px solid var(--border-card,#e2e8f0);border-radius:8px;transition:border-color 0.15s ease,box-shadow 0.15s ease}.ds-input::placeholder{color:var(--text-muted,#64748b)}.ds-input:focus{outline:none;border-color:var(--color-accent,#4f46e5);box-shadow:0 0 0 2px color-mix(in srgb,var(--color-accent,#4f46e5) 40%,transparent)}"
