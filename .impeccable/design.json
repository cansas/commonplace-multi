      "css": ".ds-tag{display:inline-block;padding:1px 8px;background-color:var(--bg-page-alt,#f1f5f9);color:var(--text-muted,#64748b);font:500 0.65rem/1.5 Inter,system-ui,sans-serif;border:1px solid var(--border-card,#e2e8f0);border-radius:9999px;white-space:nowrap;transition:background-color 0.15s ease,color 0.15s ease;cursor:default}.ds-tag:hover{background-color:var(--bg-sidebar-active,#e2e8f0);color:var(--text-secondary,#475569)}"
