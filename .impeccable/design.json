    {
      "name": "Stat Card",
      "kind": "card",
      "refersTo": "stat-card",
      "description": "Dashboard counter. Flat at rest; hover lifts 2px and draws a 2px accent gradient across the top.",
      "html": "<div class=\"ds-stat\"><div class=\"ds-stat-value\">1,284</div><div class=\"ds-stat-label\">Highlights</div></div>",
      "css": ".ds-stat{position:relative;overflow:hidden;padding:24px;background-color:var(--bg-card,#ffffff);border:1px solid var(--border-card,#e2e8f0);border-radius:12px;box-shadow:0 1px 2px rgba(0,0,0,0.05);transition:box-shadow 0.2s ease,transform 0.2s ease}.ds-stat::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--color-accent,#4f46e5),transparent);opacity:0;transition:opacity 0.3s ease}.ds-stat:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,0.06)}.ds-stat:hover::before{opacity:1}.ds-stat-value{color:var(--text-primary,#1e293b);font:700 1.875rem/1.2 Inter,system-ui,sans-serif}.ds-stat-label{margin-top:4px;color:var(--text-muted,#64748b);font:600 0.75rem/1.33 Inter,system-ui,sans-serif;letter-spacing:0.05em;text-transform:uppercase}"
    },
    {
      "name": "Highlight Card",
      "kind": "card",
      "refersTo": "card",
      "description": "A saved highlight on mobile: 12px card, 15px reading text clamped to three lines, meta row, ruled action row.",
      "html": "<div class=\"ds-hlcard\"><div class=\"ds-hlcard-text\">The unexamined life is not worth living.</div><div class=\"ds-hlcard-meta\"><strong>Socrates</strong> \u00b7 <span class=\"ds-badge ds-badge-koreader\">Koreader</span> \u00b7 <span class=\"ds-tag\">philosophy</span></div><div class=\"ds-hlcard-actions\"><span>&#9733; Favorite</span><span>Share</span></div></div>",
      "css": ".ds-hlcard{padding:14px 16px;background-color:var(--bg-card,#ffffff);border:1px solid var(--border-card,#e2e8f0);border-radius:12px;transition:box-shadow 0.15s ease,transform 0.15s ease}.ds-hlcard:hover{box-shadow:0 8px 24px rgba(0,0,0,0.06)}.ds-hlcard:active{transform:scale(0.99)}.ds-hlcard-text{color:var(--text-primary,#1e293b);font:400 0.9375rem/1.625 Inter,system-ui,sans-serif;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.ds-hlcard-meta{display:flex;flex-wrap:wrap;align-items:center;gap:6px;margin-top:8px;color:var(--text-muted,#64748b);font-size:0.75rem}.ds-hlcard-actions{display:flex;align-items:center;gap:12px;margin-top:10px;padding-top:10px;border-top:1px solid var(--border-card,#e2e8f0);color:var(--text-muted,#64748b);font-size:0.75rem;cursor:pointer}"
    },
    {
      "name": "Tag Pill",
