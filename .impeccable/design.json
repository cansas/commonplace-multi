      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;background-color:var(--btn-primary-bg,#4f46e5);color:var(--btn-primary-text,#ffffff);font:500 0.875rem/1.25 Inter,system-ui,sans-serif;border:1px solid transparent;border-radius:8px;box-shadow:0 1px 2px rgba(0,0,0,0.05);cursor:pointer;transition:background-color 0.15s ease,box-shadow 0.15s ease}.ds-btn-primary:hover{background-color:var(--btn-primary-hover,#4338ca)}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 2px color-mix(in srgb,var(--color-accent,#4f46e5) 40%,transparent)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Ruled action beside a primary, or a standalone row action.",
      "html": "<button class=\"ds-btn-secondary\">View in Context</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;gap:6px;padding:6px 16px;background-color:var(--bg-card,#ffffff);color:var(--text-secondary,#475569);font:500 0.875rem/1.25 Inter,system-ui,sans-serif;border:1px solid var(--border-card,#e2e8f0);border-radius:8px;box-shadow:0 1px 2px rgba(0,0,0,0.05);cursor:pointer;transition:background-color 0.15s ease,color 0.15s ease}.ds-btn-secondary:hover{background-color:var(--bg-page-alt,#f1f5f9);color:var(--text-primary,#1e293b)}"
    },
    {
      "name": "Text Field",
